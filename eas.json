{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://jogastop.ao",
        "EXPO_PUBLIC_WEB_URL": "https://jogastop.ao"
      },
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://jogastop.ao",
        "EXPO_PUBLIC_WEB_URL": "https://jogastop.ao"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
