{
  "expo": {
    "name": "stop-mobile",
    "slug": "stop-mobile",
    "version": "1.0.0",
    "scheme": "stop-mobile",
    "orientation": "portrait",
    "icon": "./assets/brand/jogastop-mobile-mark.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "ao.jogastop.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#062F40",
        "foregroundImage": "./assets/brand/jogastop-mobile-mark.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/brand/jogastop-mobile-mark.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-splash-screen",
      [
        "expo-audio",
        {
          "recordAudioAndroid": false
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "65bd0232-8e22-47b8-b30c-4a5aee4cc8f4"
      }
    }
  }
}
